# Python cache
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.env
.env.*
!.env.example
.venv/
venv/
env/

# IDE and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
tmp/
temp/

# 每次运行会覆盖的临时结果：不作为稳定基线提交
data/literature.db
outputs/raw/*.json
outputs/tables/*.csv
outputs/figures/*.png
outputs/reports/*.txt

# 每次运行生成的普通实验默认不提交；已跟踪的历史实验不会受此规则影响。
outputs/experiments/*

# Batch 摘要与普通实验一样默认不提交，只保留目录说明。
outputs/batches/*
!outputs/batches/README.md

# 质量门禁普通运行结果默认不提交，只跟踪目录说明。
outputs/quality/*
!outputs/quality/README.md

# outputs/baselines/ 和 outputs/live_test_*/ 不在忽略列表中。
# 这些目录只保存经过来源、安全和可复现性检查、确有必要长期保留的基线或实验结果。
