# Python cache
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.env
.env.*
!.env.example
.venv/
venv/
env/

# IDE and operating system files
.vscode/
.idea/
